<?xml version="1.0"?>
<ruleset name="PSR-12">
    <description>PSR-12 Coding Standard</description>

    <!-- PSR-12 Standard -->
    <rule ref="PSR12"/>

    <!-- Directories to check -->
    <file>src</file>
    <file>tests</file>

    <!-- Directories to ignore -->
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/var/*</exclude-pattern>
    <exclude-pattern>*/src/Bundle/CurrencyRateBundle/Migrations/*</exclude-pattern>

    <!-- Show progress -->
    <arg value="p"/>
    <!-- Show colors -->
    <arg name="colors"/>
    <!-- Show all sniff codes -->
    <arg value="s"/>
</ruleset>
