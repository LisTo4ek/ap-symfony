# Rate Providers Configuration
# Structure: rate_providers.cbr_rate_provider.*

# CBR Rate Provider - URL API ЦБР для получения курсов валют
RATE_PROVIDERS_CBR_API_URL=https://cbr.ru/scripts/XML_daily.asp

# CBR Rate Provider - Таймаут для HTTP запросов (в секундах)
RATE_PROVIDERS_CBR_TIMEOUT=30

# CBR Rate Provider - Количество попыток при ошибке
RATE_PROVIDERS_CBR_RETRY_ATTEMPTS=3

# CBR Rate Provider - Список отслеживаемых валют (через запятую)
# RATE_PROVIDERS_CBR_MONITORED_CURRENCIES=USD,EUR,GBP,JPY,CNY

