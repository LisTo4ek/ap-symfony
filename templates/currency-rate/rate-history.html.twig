{% extends 'base.html.twig' %}

{# @var pagination \App\Domain\Contracts\Pagination\PaginationResultContract #}
{# @var rate \App\Entity\RateHistory #}
{# @var rate \App\Entity\RateHistory #}
{# @var baseCurrencyCode string #}
{# @var targetCurrencyCode string #}
{# @var displayRatePrecision int #}

{% block title %}Rate History{% endblock %}

{% block body %}
    <div class="container">
        <h1>Rates history for {{ targetCurrencyCode }}</h1>

        {% if pagination and pagination.getTotalCount() > 0 %}
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th class="text-end">Rate</th>
                    </tr>
                </thead>
                <tbody>
                    {% for rate in pagination.getItems() %}
                        <tr>
                            <td>{{ rate.date|date('d.m.Y') }}</td>
                            <td class="text-end">{{ (rate.value.toString()|number_format(displayRatePrecision, '.', '')) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {% include 'components/pagination.html.twig' with {
                pagination: pagination,
                route: 'app_rates_history',
                parameters: {'baseCurrencyCode': baseCurrencyCode, 'targetCurrencyCode': targetCurrencyCode}
            } %}
        {% else %}
            <div class="alert alert-info">
                No rates found
            </div>
        {% endif %}
    </div>
{% endblock %}
