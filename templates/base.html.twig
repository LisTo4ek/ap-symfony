<!DOCTYPE html>
<html lang="ru">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>{% block title %}Новостной портал{% endblock %}</title>
        {% block stylesheets %}
            <style>
                * { margin: 0; padding: 0; box-sizing: border-box; }
                body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
                .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
                header { background: #333; color: #fff; padding: 1rem 0; margin-bottom: 2rem; }
                header h1 { text-align: center; }
                nav ul { list-style: none; }
                nav li { margin: 0.5rem 0; }
                nav a { color: #007bff; text-decoration: none; }
                nav a:hover { text-decoration: underline; }
                .comment { background: #f4f4f4; padding: 1rem; margin: 1rem 0; border-radius: 4px; }
                article { margin: 2rem 0; }
                section { margin: 2rem 0; }
            </style>
        {% endblock %}
    </head>
    <body>
        <header>
            <div class="container">
                <h1><a href="{{ path('app_home_index') }}" style="color: #fff; text-decoration: none;">Новостной портал</a></h1>
            </div>
        </header>

        <main>
            {% block body %}{% endblock %}
        </main>

        <footer>
            <div class="container">
                <p style="text-align: center; margin-top: 2rem; color: #666;">&copy; {{ 'now'|date('Y') }} Новостной портал</p>
            </div>
        </footer>

        {% block javascripts %}{% endblock %}
    </body>
</html>
