{% extends 'base.html.twig' %}

{% block title %}{{ section.name }} - News portal{% endblock %}

{% block body %}
    <h1>Sections: {{ section.name }}</h1>

    {% block staticText %}{% endblock %}

    <section class="comments">
        <h3>Comments ({{ section.commentsCount }})</h3>
        {% for i in 1..section.commentsCount %}
            <div class="comment">
                <strong>User {{ i }}</strong>
                <p>Comment #{{ i }}</p>
            </div>
        {% endfor %}
    </section>
{% endblock %}
