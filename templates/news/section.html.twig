{% extends 'base.html.twig' %}

{% block title %}{{ section.name }} - Новостной портал{% endblock %}

{% block body %}
    <h1>Раздел: {{ section.name }}</h1>

    {% block staticText %}{% endblock %}

    <section class="comments">
        <h3>Комментарии ({{ section.commentsCount }})</h3>
        {% for i in 1..section.commentsCount %}
            <div class="comment">
                <strong>Пользователь {{ i }}</strong>
                <p>Это комментарий номер {{ i }}</p>
            </div>
        {% endfor %}
    </section>
{% endblock %}
